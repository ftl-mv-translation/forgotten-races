msgid ""
"data/blueprints.xml.append$//shipBlueprint[@name=\"PLAYER_SHIP_FR_CEL_AUTO_3\"]/desc"
msgstr ""
"Une opération du Clan des Hackers a réussi à capturer et à reprogrammer cet Auto-vaisseau du L.A.C. Ils ont réutilisé une partie de la technologie du vaisseau pour fabriquer le brouilleur de système ultime.\n"
"\t\n"
"\tCe vaisseau est également livré avec une version interne des schémas du Nexus."

#: src-en/data/blueprints.xml.append:29164
