msgid ""
"data/blueprints.xml.append$//shipBlueprint[@name=\"PLAYER_SHIP_FR_PERFECTED_3\"]/desc"
msgstr ""
"Ce vaisseau est né de l'union parfaite de tous les travaux des Obélisques "
"sur l'intelligence artificielle. Les Cognitifs à bord peuvent conserver un "
"minimum de contrôle de soi, même une fois libérés."

#: src-en/data/blueprints.xml.append:22720
msgid ""
"data/blueprints.xml.append$//shipBlueprint[@name=\"PLAYER_SHIP_FR_BROKEN_COMMONWEALTH\"]/class"
msgstr "Croiseur Obélisque Déchu"

