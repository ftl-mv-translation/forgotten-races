msgstr ""
"Ce vaisseau offre une variante unique de l'artillerie Obélisque habituelle, "
"construisant des essaims de drones au lieu de tirer une charge utile."

#: src-en/data/blueprints.xml.append:23038
msgid ""
"data/blueprints.xml.append$//shipBlueprint[@name=\"PLAYER_SHIP_FR_COMMONWEALTH_3\"]/class"
msgstr "Croiseur de la Coalition"

