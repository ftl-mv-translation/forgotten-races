#: src-en/data/blueprints.xml.append:21789
msgid ""
"data/blueprints.xml.append$//shipBlueprint[@name=\"PLAYER_SHIP_FR_ELITE_OBELISK_FLAGSHIP\"]/unlock"
msgstr ""
"Détruisez l'Exterminateur et obtenez la fin de la Coalition en utilisant "
"n'importe quelle configuration de la lignée des Vaisseaux amiraux "
"Obélisques."

