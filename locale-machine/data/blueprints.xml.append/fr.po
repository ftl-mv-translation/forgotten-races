msgid ""
"data/blueprints.xml.append$//shipBlueprint[@name=\"PLAYER_SHIP_FR_PERFECTED\"]/unlock"
msgstr ""
"Débloquez tous les vaisseaux de la lignée Obélisque, de la lignée de la "
"Confédération, de la lignée Alt Aenwithe et le croiseur d'Aenwithe pour "
