msgid ""
"data/blueprints.xml.append$//shipBlueprint[@name=\"PLAYER_SHIP_FR_BROKEN_COMMONWEALTH_2\"]/unlock"
msgstr ""
"Consultez les conseils d'un Obélisque autrefois mort à propos d'un certain "
"artefact pour débloquer ce vaisseau."

