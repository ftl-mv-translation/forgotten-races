#: src-en/data/blueprints.xml.append:19168
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"FR_AETHER_PHEROMONES\"]/desc"
msgstr ""
"Une concoction de poussière d'éther et de phéromones de Mantis Libres fortement synthétisées.\n"
"\t\t\n"
"\tTant que votre système de survie est alimenté, fait en sorte que tout l'équipage allié donne +1 énergie (se cumule avec les effets existants) et les fait infliger des dégâts à la mort, ces derniers évoluant avec le niveau du système, commençant à 30 jusqu'à 120 au niveau 4. L'effet de mort se cumule également avec les effets existants."

#: src-en/data/blueprints.xml.append:19178
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"FR_NARRATIVE_SHIELD\"]/title"
msgstr "Présence du Narrateur"

#: src-en/data/blueprints.xml.append:19179
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"FR_NARRATIVE_SHIELD\"]/desc"
msgstr ""
