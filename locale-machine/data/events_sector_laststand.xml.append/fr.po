#: src-en/data/events_sector_laststand.xml.append:741
msgid ""
"data/events_sector_laststand.xml.append$//mod:findName[@name=\"BOSS_NEGOTIATE_1\"]/mod-"
"append:choice[1]/text"
msgstr ""
"Nous avons réussi à disperser toute une flotte de pirates pour sauver un "
