#: src-en/data/events_fr_sector_warzone.xml:4273
msgid ""
"data/events_fr_sector_warzone.xml$//event[@name=\"FR_HOSTILE_WARZONE_REBEL_AUTO_HACK\"]/choice[@req=\"hacking\"]/text"
msgstr "(Piratage) Empêcher leur piratage."

#: src-en/data/events_fr_sector_warzone.xml:4275
msgid ""
"data/events_fr_sector_warzone.xml$//event[@name=\"FR_HOSTILE_WARZONE_REBEL_AUTO_HACK\"]/choice[@req=\"hacking\"]/event/text"
msgstr ""
"Le virus du vaisseau de l'Innovation est beaucoup plus difficile à purger "
"que ce que vous pensiez, et vous devez surcadencer le système de piratage. "
"Vos systèmes reviennent à la normale, mais votre piratage a subi une perte "
"énorme."

